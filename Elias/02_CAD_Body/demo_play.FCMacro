# Gripper demo: opens out/gripper.FCStd and adds a dock with a play button.
import math
import os
import sys

import FreeCAD as App
import FreeCADGui as Gui
from PySide import QtCore, QtGui

ROOT = "C:/git/FH/PDE/Elias/02_CAD_Body"
sys.path.insert(0, ROOT)
import gripper_params as P  # noqa: E402
from parts import demo_seq  # noqa: E402
import importlib  # noqa: E402
importlib.reload(demo_seq)

COLORS = {"EN AW-6082": (0.72, 0.75, 0.78), "EN AW-7075": (0.76, 0.25, 0.05), "steel": (0.45, 0.48, 0.50),
          "vendor": (0.16, 0.17, 0.18), "NBR": (0.08, 0.08, 0.08), "PA 6": (0.93, 0.90, 0.80), "table": (0.35, 0.38, 0.40)}
SEE_THROUGH = {"Housing": 70, "Cover": 70, "Tower": 70}
GRIP_COLOR, PAD_COLOR = (0.15, 0.65, 0.25), COLORS["NBR"]


def get_doc():
    path = os.path.join(ROOT, "out", "gripper.FCStd")
    for d in list(App.listDocuments().values()):
        if os.path.normcase(d.FileName) == os.path.normcase(path):
            App.closeDocument(d.Name)   # reload so a rebuilt file is picked up
    return App.openDocument(path)


# Exploded view: (assembly step from CAD_PLAN.md section 8, offset at full explosion). Side = o.Side (-1 / +1).
def explode(o):
    n, s = o.Label, o.Side   # FreeCAD turns "-" into "_" in names and labels
    rules = [
        ("Screw_ISO10642-M5x16_Adapter", 10, (0, 0, 230)), ("Adapter_ISO9409", 10, (0, 0, 190)),
        ("Screw_ISO4762-M3x8_Window", 9, (80, 0, 0)), ("Cable_Gland", 9, (65, 0, 0)), ("Window_Plate", 9, (50, 0, 0)),
        ("Screw_ISO4762-M3x8_Pad", 8, (45 * s, 0, -200)), ("Washer_", 8, (35 * s, 0, -200)),
        ("PadPlate_", 8, (-10 * s, 0, -235)), ("Pad_", 8, (-10 * s, 0, -235)), ("Jaw_", 8, (12 * s, 0, -200)),
        ("Screw_ISO4762-M4x16_Cover", 7, (0, 0, -175)), ("Cover", 7, (0, 0, -140)),
        ("Plunger_", 6, (40 * s, 0, -120)), ("Dowel_ISO8734-4x12", 6, (-15 * s, 0, -120)),
        ("Screw_ISO4762-M4x25_Holder", 6, (0, 0, -150)), ("Holder_", 6, (0, 0, -120)),
        ("Screw_ISO4762-M3x8_Carriage", 5, (0, 0, -115)), ("Screw_ISO4762-M3x10_Rack", 5, (0, 0, -115)),
        ("Dowel_ISO8734-3x14_Rack", 5, (0, 0, -115)), ("Slide_", 5, (0, 0, -90)), ("Carriage_", 5, (0, 0, -55)),
        ("Rack_", 5, (0, 0, -55)),
        ("Setscrew_", 4, (-25, 0, -40)), ("Pinion", 4, (0, 0, -40)),
        ("Screw_ISO4762-M4x16_Tower", 3, (0, 0, -55)), ("Tower", 3, (0, 0, 150)),
        ("Screw_ISO4762-M4x16_Gearbox", 2, (0, 0, -50)), ("Gearbox", 2, (0, 0, 60)), ("Motor", 2, (0, 0, 60)),
        ("Brake", 2, (0, 0, 60)),
        ("Screw_ISO4762-M3x8_Rail", 1, (0, 0, -60)), ("Rail", 1, (0, 0, -35)),
    ]
    n = n.replace("-", "_")
    for prefix, step, off in rules:
        if n.startswith(prefix.replace("-", "_")):
            return step, App.Vector(*off)
    return 0, App.Vector(0, 0, 0)


N_STEPS = 10


class Demo(QtGui.QDockWidget):
    def __init__(self, doc):
        super().__init__("Greifer-Demo")
        self.setObjectName("GripperDemoDock")
        self.doc, self.t, self.speed = doc, 0.0, 0.5
        self.objs = [o for o in doc.Objects if hasattr(o, "Role")]
        for o in self.objs:
            vo = o.ViewObject
            vo.Visibility = True  # file comes from freecadcmd without GUI state
            vo.ShapeColor = COLORS.get(o.Material, (0.6, 0.6, 0.6))
            vo.Transparency = SEE_THROUGH.get(o.Name, 0)
        w = QtGui.QWidget()
        lay = QtGui.QVBoxLayout(w)
        self.btn = QtGui.QPushButton("▶  Play")
        self.btn.setMinimumHeight(36)
        self.btn.clicked.connect(self.toggle)
        lay.addWidget(self.btn)
        row = QtGui.QHBoxLayout()
        row.addWidget(QtGui.QLabel("Tempo"))
        self.sp = QtGui.QComboBox()
        self.sp.addItems(["0,25×", "0,5×", "1× (echte Taktzeit)"])
        self.sp.setCurrentIndex(1)
        self.sp.currentIndexChanged.connect(lambda i: setattr(self, "speed", (0.25, 0.5, 1.0)[i]))
        row.addWidget(self.sp)
        lay.addLayout(row)
        self.see = QtGui.QCheckBox("Gehäuse durchsichtig")
        self.see.setChecked(True)
        self.see.toggled.connect(self.toggle_see)
        lay.addWidget(self.see)
        self.slider = QtGui.QSlider(QtCore.Qt.Horizontal)
        self.slider.setRange(0, int(demo_seq.DURATION * 100))
        self.slider.sliderMoved.connect(lambda v: self.seek(v / 100))
        lay.addWidget(self.slider)
        self.info = QtGui.QLabel()
        self.info.setStyleSheet("font-family: Consolas, monospace;")
        lay.addWidget(self.info)
        lay.addWidget(QtGui.QLabel("Explosionsansicht"))
        self.ex = QtGui.QSlider(QtCore.Qt.Horizontal)
        self.ex.setRange(0, 100)
        self.ex.valueChanged.connect(lambda v: self.seek(self.t))
        lay.addWidget(self.ex)
        self.asm = QtGui.QPushButton("Montage Schritt für Schritt")
        self.asm.clicked.connect(self.play_assembly)
        lay.addWidget(self.asm)
        self.step_info = QtGui.QLabel()
        self.step_info.setWordWrap(True)
        lay.addWidget(self.step_info)
        lay.addStretch(1)
        self.setWidget(w)
        self.explode = {o.Name: explode(o) for o in self.objs}
        self.asm_tau = None
        self.timer = QtCore.QTimer()
        self.timer.timeout.connect(self.tick)
        self.asm_timer = QtCore.QTimer()
        self.asm_timer.timeout.connect(self.tick_assembly)
        self.seek(0.0)

    STEP_TEXT = ["", "Schiene an Anschlagkante, 5 × M3×8", "Antrieb auf die Deckplatte, 4 × M4×16 von unten",
                 "Motorgehäuse über den Antrieb, 4 × M4×16 von unten", "Ritzel mit Passfeder, Gewindestift M4×4",
                 "Wagen, Schlitten (4 × M3×8), Zahnstangen (2 × M3×10 im Langloch, ausrichten, Stift Ø3)",
                 "Backenhalter mit Passstiften, 2 × M4×25", "Deckel, 4 × M4×16",
                 "Backen auf die Stifte, Arretierbolzen rastet ein; Belagplatten 2 × M3×8",
                 "Fensterplatte mit Kabelverschraubung, 4 × M3×8", "Adapter am Roboter, Greifer mit 4 × M5×16 von oben"]

    def play_assembly(self):
        self.timer.stop()
        self.btn.setText("▶  Play")
        self.asm_tau = 0.0
        self.last = QtCore.QElapsedTimer()
        self.last.start()
        self.asm_timer.start(20)

    def tick_assembly(self):
        self.asm_tau += self.last.restart() / 1000.0 * 0.8      # steps per second
        if self.asm_tau >= N_STEPS + 1:
            self.asm_timer.stop()
            self.asm_tau = None
            self.step_info.setText("")
        self.seek(self.t)

    def toggle(self):
        if self.timer.isActive():
            self.timer.stop()
            self.btn.setText("▶  Play")
        else:
            self.last = QtCore.QElapsedTimer()
            self.last.start()
            self.timer.start(20)
            self.btn.setText("❚❚  Pause")

    def toggle_see(self, on):
        for o in self.objs:
            if o.Name in SEE_THROUGH:
                o.ViewObject.Transparency = SEE_THROUGH[o.Name] if on else 0

    def tick(self):
        dt = self.last.restart() / 1000.0
        self.seek((self.t + dt * self.speed) % demo_seq.DURATION)

    def seek(self, t):
        self.t = t
        d, zg, zp = demo_seq.state(t, P.D_GRIP)
        f_all = self.ex.value() / 100.0
        exploding = f_all > 0 or self.asm_tau is not None
        if exploding:
            d, zg, zp = P.D_GRIP, 0.0, 0.0
        dd = d - P.D_GRIP
        ang = math.degrees(dd / (P.PINION_D / 2))
        grip = d <= P.D_GRIP + 1e-6
        if self.asm_tau is not None:
            k = min(int(self.asm_tau), N_STEPS)
            self.step_info.setText(f"Schritt {k}: {self.STEP_TEXT[k]}" if k else "Gehäuse als Basis")
        for o in self.objs:
            if o.Role in ("part", "table"):
                o.ViewObject.Visibility = not exploding
            step, off = self.explode[o.Name]
            if self.asm_tau is not None:      # parts arrive in assembly order
                f = 1.0 if self.asm_tau < step else max(0.0, 1.0 - (self.asm_tau - step))
            else:
                f = f_all
            base = o.BasePlacement   # shapes carry their own placement from the build; move relative to it
            base = App.Placement(off * f, App.Rotation()).multiply(base)
            if o.Role == "slide":
                delta = App.Placement(App.Vector(o.Side * dd, 0, zg), App.Rotation())
            elif o.Role == "pinion":
                delta = App.Placement(App.Vector(0, 0, zg), App.Rotation(App.Vector(0, 0, 1), ang))
            elif o.Role == "static":
                delta = App.Placement(App.Vector(0, 0, zg), App.Rotation())
            elif o.Role == "part":
                delta = App.Placement(App.Vector(0, 0, zp), App.Rotation())
            else:
                delta = App.Placement()
            o.Placement = delta.multiply(base)
            if o.Label.startswith("Pad_"):
                o.ViewObject.ShapeColor = GRIP_COLOR if grip else PAD_COLOR
        phase = "hält Bauteil B" if grip else ("schließt" if dd > 0 and zg == 0 else "offen")
        self.info.setText(f"t = {t:4.1f} s\nBackenabstand {2 * (P.PAD_X0 + d):5.1f} mm\n"
                          f"Ritzel        {ang + math.degrees(P.D_GRIP / (P.PINION_D / 2)):5.1f}°\n"
                          f"Hub           {zg:5.1f} mm\n{phase}")
        self.slider.blockSignals(True)
        self.slider.setValue(int(t * 100))
        self.slider.blockSignals(False)
        Gui.updateGui()


def run():
    doc = get_doc()
    App.setActiveDocument(doc.Name)
    mw = Gui.getMainWindow()
    old = mw.findChild(QtGui.QDockWidget, "GripperDemoDock")
    if old:
        old.timer.stop() if hasattr(old, "timer") else None
        old.deleteLater()
    dock = Demo(doc)
    mw.addDockWidget(QtCore.Qt.RightDockWidgetArea, dock)
    v = Gui.ActiveDocument.ActiveView
    v.viewIsometric()
    v.fitAll()
    return dock


demo_dock = run()
